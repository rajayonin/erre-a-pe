---
import type { Catalog, Song } from '../lib/types';
import InfoChip from './InfoChip.astro';

interface Props {
  song: Song;
  catalog: Catalog;
}

const { song, catalog } = Astro.props;

const peopleById = new Map(catalog.people.map((person) => [person.id, person]));
const album = catalog.albums.find((entry) => entry.id === song.albumId);
const mcs = song.credits.mcs.map((id) => peopleById.get(id)).filter(Boolean);
const djs = song.credits.djs.map((id) => peopleById.get(id)).filter(Boolean);
---

<div class="song-details">
  <details class="panel panel-collapsible" open>
    <summary class="panel-title">
      <span>Disco</span>
      <svg class="panel-chevron" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="panel-content">
      <dl class="album-facts">
        <dt class="fact-label">Álbum</dt>
        <dd class="fact-value">{album?.title ?? song.albumId}</dd>
        <dt class="fact-label">Artista</dt>
        <dd class="fact-value">{album?.artist ?? song.artist}</dd>
        {album?.year && (
          <>
            <dt class="fact-label">Año</dt>
            <dd class="fact-value">{album.year}</dd>
          </>
        )}
        {album?.place && (
          <>
            <dt class="fact-label">Ciudad</dt>
            <dd class="fact-value">{album.place}</dd>
          </>
        )}
        {album?.label && (
          <>
            <dt class="fact-label">Sello</dt>
            <dd class="fact-value">{album.label}</dd>
          </>
        )}
      </dl>
    </div>
  </details>

  <details class="panel panel-collapsible" open>
    <summary class="panel-title">
      <span>En la grabación</span>
      <svg class="panel-chevron" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>
    <div class="panel-content">
      {
        mcs.length > 0 && (
          <div class="credit-row">
            <span class="credit-label">MC{mcs.length > 1 ? <span class="credit-label-s">s</span> : ''}</span>
            <div class="chip-list">
              {mcs.map((person) => (
                <InfoChip info={person!} peopleById={peopleById} currentYear={album?.year} />
              ))}
            </div>
          </div>
        )
      }
      {
        djs.length > 0 && (
          <div class="credit-row">
            <span class="credit-label">DJ{djs.length > 1 ? <span class="credit-label-s">s</span> : ''}</span>
            <div class="chip-list">
              {djs.map((person) => (
                <InfoChip info={person!} peopleById={peopleById} currentYear={album?.year} />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </details>
</div>
