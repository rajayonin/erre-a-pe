---
import type { Album, Song } from '../lib/types';
import { assetUrl } from '../lib/assets';
import { resolveArtistInfo } from '../lib/people';
import InfoChip from './InfoChip.astro';
import type { Catalog } from '../lib/types';

interface Props {
  song: Song;
  album: Album;
  catalog: Catalog;
  position: number;
  total: number;
}

const { song, album, catalog, position, total } = Astro.props;
const peopleById = new Map(catalog.people.map((person) => [person.id, person]));
const artistInfo = resolveArtistInfo(catalog.people, catalog.groups, song.artist);
const featureInfo = song.features.map((name) => ({
  name,
  info: resolveArtistInfo(catalog.people, catalog.groups, name),
}));
const cover = assetUrl(album.cover);

const meta = [album.year, album.place, album.label].filter(Boolean) as (number | string)[];
---

<header class="song-hero">
  <div class="hero-bg-clip" aria-hidden="true">
    {cover && <img class="hero-bg" src={cover} alt="" decoding="async" />}
  </div>
  <div class="hero-inner">
    <div class="cover-wrap">
      {
        cover ? (
          <img src={cover} alt={`Portada de ${album.title}`} fetchpriority="high" decoding="async" />
        ) : (
          <div class="cover-fallback">
            {album.title
              .split(/\s+/)
              .slice(0, 2)
              .map((w) => w[0])
              .join('')
              .toUpperCase()}
          </div>
        )
      }
    </div>
    <div class="hero-copy">
      <p class="eyebrow">
        {String(position).padStart(2, '0')} / {String(total).padStart(2, '0')}
      </p>
      <h1 class="song-title">{song.title}</h1>
      <div class="song-artist">
        {artistInfo ? (
          <InfoChip info={artistInfo} peopleById={peopleById} variant="trigger" />
        ) : (
          song.artist
        )}
        {
          featureInfo.length > 0 && (
            <span class="song-features">
              {' '}feat.{' '}
              {featureInfo.map((feature, index) => (
                <>
                  {index > 0 && ', '}
                  {feature.info ? (
                    <InfoChip info={feature.info} peopleById={peopleById} variant="trigger" />
                  ) : (
                    feature.name
                  )}
                </>
              ))}
            </span>
          )
        }
      </div>
      {
        meta.length > 0 && (
          <div class="hero-meta">
            {meta.map((entry) => (
              <span>{entry}</span>
            ))}
          </div>
        )
      }
      <div class="listen">
        <a
          class="listen-link listen-link--icon"
          href={song.listen.youtube}
          target="_blank"
          rel="noopener noreferrer"
          title={`Buscar «${song.title}» en YouTube`}
          aria-label={`Buscar «${song.title}» en YouTube`}
        >
          <span
            class="listen-icon"
            aria-hidden="true"
            set:html={'<svg viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="4" fill="currentColor" opacity=".16"/><path d="M10 9.1v5.8l5.2-2.9L10 9.1Z" fill="currentColor"/></svg>'}
          />
          <span class="listen-text">YouTube</span>
        </a>
        <a
          class="listen-link listen-link--icon"
          href={song.listen.spotify}
          target="_blank"
          rel="noopener noreferrer"
          title={`Buscar «${song.title}» en Spotify`}
          aria-label={`Buscar «${song.title}» en Spotify`}
        >
          <span
            class="listen-icon"
            aria-hidden="true"
            set:html={'<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="currentColor" opacity=".16"/><path d="M7.3 9.4c3.2-1 6.4-.6 9.2 1M7.7 12.3c2.6-.8 5.2-.4 7.5.8M8.1 15.1c2-.6 4.1-.3 5.9.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>'}
          />
          <span class="listen-text">Spotify</span>
        </a>
        {
          (song.links ?? []).map((link) => (
            <a
              class="listen-link"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
            >
              <span class="listen-text">{link.label}</span>
            </a>
          ))
        }
      </div>
      {
        song.audio && (
          <audio
            class="audio-player"
            controls
            preload="none"
            src={assetUrl(song.audio) ?? undefined}
          />
        )
      }
    </div>
  </div>
</header>
