---
import type { Group, Person } from '../lib/types';

interface Props {
  /** A person or a group; the popover content adapts. */
  info: Person | Group;
  /** Needed to resolve group member names. */
  peopleById?: Map<string, Person>;
  /** If provided, the pill shows the age the person had at that year */
  currentYear?: number;
  /**
   * 'chip' renders the pill used for credits; 'trigger' renders the
   * underlined text used for artist/feature names.
   */
  variant?: 'chip' | 'trigger';
}

const { info, peopleById, currentYear, variant = 'chip' } = Astro.props;
const isPerson = 'kind' in info && info.kind !== undefined;
const isPassed = isPerson && Boolean((info as Person).passed);
const displayName = isPassed ? `${info.name} (†)` : info.name;

const kind = isPerson ? (info.kind === 'dj' ? 'DJ' : 'MC') : 'Grupo';
const color = isPerson ? info.color : 'var(--accent-2)';

type Row = [string, string, boolean?];
const rows: Row[] = [];

if (isPerson) {
  const person = info as Person;
  if (person.carreer?.start) rows.push(['Años', `${person.carreer.start}–${person.carreer.end ?? 'presente'}`]);
  if (person.fullName) rows.push(['Nombre', person.fullName]);
  if (person.aliases.length) rows.push(['Alias', person.aliases.join(', ')]);
  if (person.birthplace) rows.push(['Ciudad', person.birthplace]);
  if (person.birthyear) rows.push(
    currentYear ?
    ['Edad', `${currentYear - person.birthyear} (${person.birthyear})`]
    : ['Fecha nacimiento', person.birthyear.toString()]
  );
  if (person.groups.length) rows.push(['Grupos', person.groups.map((g) => g.name).join(', ')]);
} else {
  const group = info as Group;
  if (group.carreer?.start) rows.push(['Años', `${group.carreer.start}–${group.carreer.end ?? 'presente'}`]);
  const memberSummary = (id: string) => {
    const person = peopleById?.get(id);
    if (!person) return id;
    return person.passed ? `${person.name} (†)` : person.name;
  };
  if (group.mcs.length) rows.push(['MC', group.mcs.map(memberSummary).join(', '), group.mcs.length > 1]);
  if (group.djs.length) rows.push(['DJ', group.djs.map(memberSummary).join(', '), group.djs.length > 1]);
}

const rootClass = variant === 'chip' ? 'chip chip-details' : 'info-trigger';
---

<details class={rootClass} style={`--person-color: ${color}`}>
  <summary>
    {variant === 'chip' && <span class="chip-dot" aria-hidden="true"></span>}
    {displayName}
  </summary>
  <div class="chip-pop" role="dialog" aria-label={`Información sobre ${displayName}`}>
    <p class="chip-pop-head">
      <span class="chip-pop-dot" aria-hidden="true"></span>
      <span>
        <strong class="chip-pop-name">{displayName}</strong>
        <span class="chip-pop-kind">{kind}</span>
      </span>
    </p>
    {
      rows.length ? (
        <dl class="chip-pop-facts">
          {rows.map(([label, value, plural]) => (
            <>
              <dt>{label}{plural && <span class="credit-label-s">s</span>}</dt>
              <dd>{value}</dd>
            </>
          ))}
        </dl>
      ) : (
        <p class="chip-pop-empty">Sin información adicional.</p>
      )
    }
  </div>
</details>
