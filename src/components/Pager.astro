---
import type { Song } from '../lib/types';

interface Props {
  songs: Song[];
  songId: string;
}

const { songs, songId } = Astro.props;
const index = songs.findIndex((song) => song.id === songId);
const previous = index > 0 ? songs[index - 1] : undefined;
const next = index >= 0 && index < songs.length - 1 ? songs[index + 1] : undefined;
---

{
  (previous || next) && (
    <nav class="pager" aria-label="Otras canciones">
      {previous && (
        <a class="pager-link prev" href={`${import.meta.env.BASE_URL}/song/${previous.id}/`}>
          <span class="pager-arrow" aria-hidden="true">
            ←
          </span>
          <span class="pager-copy">
            <span class="pager-label">Anterior</span>
            <span class="pager-title">
              {previous.title} — {previous.artist}
            </span>
          </span>
        </a>
      )}
      {next && (
        <a class="pager-link next" href={`${import.meta.env.BASE_URL}/song/${next.id}/`}>
          <span class="pager-copy">
            <span class="pager-label">Siguiente</span>
            <span class="pager-title">
              {next.title} — {next.artist}
            </span>
          </span>
          <span class="pager-arrow" aria-hidden="true">
            →
          </span>
        </a>
      )}
    </nav>
  )
}
