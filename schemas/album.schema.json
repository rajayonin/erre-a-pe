{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erre-a-pe.local/schemas/album.schema.json",
  "title": "Album",
  "description": "A normalized album in the generated catalog.",
  "type": "object",
  "required": ["id", "title", "artist", "songIds"],
  "properties": {
    "id": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/slug" },
    "title": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
    "artist": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "place": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
    "label": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
    "cover": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
    "links": {
      "type": "array",
      "items": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/link" }
    },
    "songIds": {
      "type": "array",
      "items": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/slug" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
