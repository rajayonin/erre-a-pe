{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erre-a-pe.local/schemas/mcs-file.schema.json",
  "title": "mcs.yaml",
  "type": "object",
  "required": ["mcs"],
  "properties": {
    "mcs": {
      "type": "array",
      "items": { "$ref": "#/$defs/mc" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mc": {
      "type": "object",
      "required": ["artist-name"],
      "properties": {
        "artist-name": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
        "full-name": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "birthplace": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
        "birthyear": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "carreer": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/career" }
      },
      "additionalProperties": false
    }
  }
}
