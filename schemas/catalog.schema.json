{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erre-a-pe.local/schemas/catalog.schema.json",
  "title": "Site catalog",
  "description": "The single JSON document consumed by the static site.",
  "type": "object",
  "required": ["meta", "people", "groups", "albums", "songs"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "tagline", "songCount", "albumCount"],
      "properties": {
        "title": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
        "tagline": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
        "songCount": { "type": "integer", "minimum": 0 },
        "albumCount": { "type": "integer", "minimum": 0 },
        "place": {
          "type": ["string", "null"],
          "description": "Place shown in the sidebar subtitle."
        },
        "playlist": {
          "type": ["object", "null"],
          "properties": {
            "label": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
            "url": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "people": {
      "type": "array",
      "items": { "$ref": "https://erre-a-pe.local/schemas/person.schema.json" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "https://erre-a-pe.local/schemas/group.schema.json" }
    },
    "albums": {
      "type": "array",
      "items": { "$ref": "https://erre-a-pe.local/schemas/album.schema.json" }
    },
    "songs": {
      "type": "array",
      "items": { "$ref": "https://erre-a-pe.local/schemas/song.schema.json" }
    }
  },
  "additionalProperties": false
}
