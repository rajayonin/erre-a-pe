{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erre-a-pe.local/schemas/groups-file.schema.json",
  "title": "groups.yaml",
  "type": "object",
  "required": ["groups"],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "id": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/slug" },
          "name": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
          "carreer": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/career" },
          "mcs": {
            "type": "array",
            "items": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
            "uniqueItems": true
          },
          "djs": {
            "type": "array",
            "items": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
