{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erre-a-pe.local/schemas/common.schema.json",
  "title": "Shared definitions",
  "description": "Reusable pieces for the Erre a Pé data schemas.",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "URL-safe identifier, lowercase ASCII words separated by single dashes."
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "A string containing at least one non-whitespace character."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "An absolute http(s) URL."
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "$ref": "#/$defs/url" }
      },
      "additionalProperties": false
    },
    "groupRef": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "personId": {
      "$ref": "#/$defs/slug"
    },
    "albumId": {
      "$ref": "#/$defs/slug"
    }
  }
}
