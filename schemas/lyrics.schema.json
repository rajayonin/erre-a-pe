{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erre-a-pe.local/schemas/lyrics.schema.json",
  "title": "Parsed lyrics",
  "description": "A lyrics document split into labelled parts and stanzas.",
  "type": "object",
  "required": ["songId", "source", "parts"],
  "properties": {
    "songId": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/slug" },
    "source": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
    "parts": {
      "type": "array",
      "items": { "$ref": "#/$defs/part" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "part": {
      "type": "object",
      "required": ["id", "label", "kind", "performers", "stanzas"],
      "properties": {
        "id": { "type": "string", "pattern": "^part-[0-9]+$" },
        "label": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
        "kind": {
          "enum": ["intro", "verse", "pre-chorus", "chorus", "bridge", "interlude", "outro", "other"]
        },
        "performers": {
          "type": "array",
          "items": { "$ref": "#/$defs/performer" }
        },
        "stanzas": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "performer": {
      "type": "object",
      "required": ["id", "name", "kind", "color"],
      "properties": {
        "id": {
          "anyOf": [
            { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/slug" },
            { "type": "null" }
          ]
        },
        "name": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
        "kind": { "enum": ["mc", "dj", "other"] },
        "color": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/hexColor" }
      },
      "additionalProperties": false
    }
  }
}
