{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erre-a-pe.local/schemas/group.schema.json",
  "title": "Group",
  "description": "A normalized group in the generated catalog.",
  "type": "object",
  "required": ["id", "name", "mcs", "djs"],
  "properties": {
    "id": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/slug" },
    "name": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/nonEmptyString" },
    "carreer": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/career" },
    "mcs": {
      "type": "array",
      "items": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/personId" },
      "uniqueItems": true
    },
    "djs": {
      "type": "array",
      "items": { "$ref": "https://erre-a-pe.local/schemas/common.schema.json#/$defs/personId" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
